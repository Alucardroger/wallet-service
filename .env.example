# Copy to .env only if you need to change a value. These are the defaults,
# which match docker-compose.yml.

# HTTP
PORT=3000
LOG_LEVEL=info                      # debug | info | warn | error | silent

# PostgreSQL
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet
TEST_DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet_test
DB_LOCK_TIMEOUT_MS=5000             # wait for a wallet row lock before answering 503

# SQS (MiniStack locally)
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_CREATE_QUEUES=true              # false where the queues are provisioned elsewhere

# Queue consumer
CONSUMER_ENABLED=true
CONSUMER_NAME=wager-transactions-consumer
CONSUMER_MAX_RECEIVES=5             # deliveries before a message goes to the DLQ
CONSUMER_WAIT_SECONDS=5
CONSUMER_VISIBILITY_SECONDS=30
CONSUMER_RETRY_BASE_SECONDS=2       # retry delay: base * 2^(deliveries - 1), up to 300s

# Outbox publisher
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_MS=500

# Out-of-order references (REFUND/ROLLBACK before the referenced transaction)
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_POLL_MS=1000
REFERENCE_MAX_ATTEMPTS=6
REFERENCE_RETRY_BASE_MS=5000        # waits 5s, 10s, 20s, 40s, 80s, 160s
